{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "AllowedHosts": "*",

  "Clipping": {
    "MaxConcurrentJobs": 3,
    "MaxParallelClips": 3,
    "ClipRetentionDays": 7
  },

 


  "ConnectionStrings": {
    "DefaultConnection": ""
  },


  "JwtSettings": {
    "Key": "super secret unguessable key for abbsium software company",
    "Issuer": "Abbsium",
    "Audience": "YourAppAudience",
    "ExpiresInMinutes": "60"
  },

  

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 60
      },
      {
        "Endpoint": "*",
        "Period": "10m",
        "Limit": 300
      },
      {
        "Endpoint": "POST:/Account/login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/Account/register",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/Account/reset-password",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/Account/forgetPassword",
        "Period": "15m",
        "Limit": 5
      },
      {
        "Endpoint": "GET:/PublicCar/dealer/*/cars",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/PublicCar/dealer/*/cars/*",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/PublicCar/dealer/*/info",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/PublicCar/dealer/*/featured-cars",
        "Period": "1m",
        "Limit": 30
      }
    ]
  }

}